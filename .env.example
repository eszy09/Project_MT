# Local development only. Copy this file to .env before starting services.

# PostgreSQL
POSTGRES_DB=project_mt
POSTGRES_USER=project_mt
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=project_mt_minio
MINIO_ROOT_PASSWORD=local-development-only
S3_BUCKET=project-mt-local
S3_REGION=us-east-1
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Application-facing values for later API configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/project_mt
DATABASE_USERNAME=project_mt
DATABASE_PASSWORD=local-development-only
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=project_mt_minio
S3_SECRET_KEY=local-development-only
S3_FORCE_PATH_STYLE=true

