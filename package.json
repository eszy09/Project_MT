{
  "name": "project-mt",
  "version": "1.0.0",
  "description": "Project_MT is a fitness application that makes transformation tracking more intuitive through reliable set-by-set workout logging, progress tracking, explainable guidance, and interactive 3D body models.",
  "scripts": {
    "dev:web": "npm --workspace @project-mt/web run dev",
    "build:web": "npm --workspace @project-mt/web run build",
    "lint:web": "npm --workspace @project-mt/web run lint",
    "typecheck:web": "npm --workspace @project-mt/web run typecheck",
    "format:web": "npm --workspace @project-mt/web run format",
    "format:check:web": "npm --workspace @project-mt/web run format:check",
    "test:web": "npm --workspace @project-mt/web run test",
    "build:body-model": "node scripts/body-model/build-body-model.mjs",
    "check:body-model": "node scripts/body-model/check-body-model.mjs",
    "generate:api-contract": "npm --workspace @project-mt/api-contract run generate",
    "check:api-contract": "npm --workspace @project-mt/api-contract run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eszy09/Project_MT.git"
  },
  "bugs": {
    "url": "https://github.com/eszy09/Project_MT/issues"
  },
  "homepage": "https://github.com/eszy09/Project_MT#readme",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "devDependencies": {
    "@cocos/fbx2gltf": "^1.0.8",
    "@comfyorg/fbx-exporter-three": "^1.0.1",
    "@gltf-transform/cli": "^4.4.1"
  }
}
